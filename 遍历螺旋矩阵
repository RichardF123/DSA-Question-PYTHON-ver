class Solution:
    def spiralOrder(self, matrix: List[List[int]]) -> List[int]:
        startx = 0
        starty = 0
        direction_matrix = [[0,1],[1,0],[0,-1],[-1,0]]
        direction_index = 0
        m = len(matrix)
        n = len(matrix[0])
        ans = [0]*(n*m)
        vistied_position = [[False]*n for _ in range(m)]
        if m == 0:
            return []
        if m == 1 and n == 1:
            return [matrix[0][0]]
        for i in range(m*n):
            if direction_index == 0 and (starty + 1 == n or vistied_position[startx][starty + 1] == True):
                direction_index = direction_index + 1
            if direction_index == 1 and (startx + 1 == m or vistied_position[startx + 1][starty] == True):
                direction_index = direction_index + 1
            if direction_index == 2 and (starty - 1 == -1 or vistied_position[startx][starty - 1] == True):
                direction_index = direction_index + 1
            if direction_index == 3 and (startx - 1 == -1 or vistied_position[startx - 1][starty] == True):
                direction_index = direction_index + 1
            if direction_index == 4:
                direction_index = 0 
            ans[i] = matrix[startx][starty]
            vistied_position[startx][starty] = True
            startx, starty = startx + direction_matrix[direction_index][0], starty + direction_matrix[direction_index][1]
        return an
