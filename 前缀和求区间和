import sys
input = sys.stdin.read

def main():
    data = input().split()
    ptr = 0
    n = int(data[ptr])
    ptr += 1
    
    pre_sum = 0
    vec = [0] * n
    for i in range(n):
        pre_sum += int(data[ptr])
        vec[i] = pre_sum
        ptr += 1
    
    ans = []

    while ptr + 1 < len(data):
        a = int(data[ptr])
        b = int(data[ptr + 1])
        ptr += 2
        
        if a == 0:
            res = vec[b]
        else:
            res = vec[b] - vec[a - 1]
        ans.append(res)
    
    for val in ans:
        print(val)

if __name__ == '__main__':
    main()
