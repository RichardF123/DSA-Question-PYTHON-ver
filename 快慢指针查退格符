class Solution:
    def backspaceCompare(self, s: str, t: str) -> bool:
        def build_arr(s:str) -> List[str]:
            n = len(s)
            arr = []
            for i in range(n):
                arr.append(s[i])
            slow = 0
            fast = 0
            while fast < n:
                if arr[fast] != '#':
                    arr[slow] = arr[fast]
                    slow = slow + 1
                else:
                    if slow > 0:
                        slow = slow - 1
                fast = fast + 1
            return arr[:slow]
        s = build_arr(s)
        t = build_arr(t)
        return (s == t)
