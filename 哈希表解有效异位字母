class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        record = [0 for x in range(26)]
        for x in s:
            record[ord(x) - ord("a")] += 1
        for x in t:
            record[ord(x) - ord("a")] -= 1
        for i in range(26):
            if record[i] != 0:
                return False
        return True
