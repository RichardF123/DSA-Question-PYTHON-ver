class Solution:
    def reverseStr(self, s: str, k: int) -> str:
        def reverse_s (text):
            left = 0
            right = len(text) - 1
            while left < right:
                text[left], text[right] = text[right], text[left]
                left += 1
                right -= 1
            return text
        r = list(s)
        for i in range(0, len(r), 2*k):
            r[i:i+k] = reverse_s(r[i:i + k])
        return ''.join(r)
