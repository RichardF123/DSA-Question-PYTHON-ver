class Solution:
    def isPerfectSquare(self, num: int) -> bool:
        left = 0
        right = num
        while left <= right:
            middle = int((left + right) / 2) 
            if middle**2 == num:
                return True
            if middle**2 < num:
                left = middle + 1
            if middle**2 > num:
                right = middle - 1
        return False
