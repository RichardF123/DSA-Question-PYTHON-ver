class Solution:
    def searchRange(self, nums: List[int], target: int) -> List[int]:
        # 优先寻找容易找到的返回条件
        if not nums: # 输入列表为空值则直接返回[-1,-1]
            return [-1,-1]
        if len(nums) == 1 and nums[0] != target: # 输入列表长度为1且唯一元素不是目标值则直接返回[-1,-1]
            return [-1,-1]
        if len(nums) == 1 and nums[0] == target: # 输入列表长度为1且唯一元素是目标值则直接返回[0,0]
            return  [0,0]
        left, right = 0 , len(nums) - 1
        while left <= right: # 使用两侧闭合二分查找随便找到一个目标值
            middle = int((left + right) / 2)
            if nums[middle] > target:
                right = middle - 1
            elif nums[middle] < target:
                left = middle + 1
            else:
                break
        if nums[middle] != target: # 如果列表里不含目标值则直接返回[-1,-1]
            return[-1,-1]
        i,j = 1, 1
        index_0 = 0
        index_1 = len(nums) - 1
        while middle - i >= 0: # 如果列表里包含目标值则从当前已知目标值向前寻找第一次出现的目标值的索引
            if nums[middle - i] != target:
                index_0 = middle - i + 1
                break
            i = i + 1
        while middle + j <= len(nums) - 1: # 同理寻找最后一次出现目标值的索引
            if nums[middle + j] != target:
                index_1 = middle + j - 1
                break
            j = j + 1
        return [index_0,index_1] 
         
