class Solution:
    def searchRange(self, nums: List[int], target: int) -> List[int]:
        if not nums:
            return [-1,-1]
        if len(nums) == 1 and nums[0] != target:
            return [-1,-1]
        if len(nums) == 1 and nums[0] == target:
            return  [0,0]
        left, right = 0 , len(nums) - 1
        while left <= right:
            middle = int((left + right) / 2)
            if nums[middle] > target:
                right = middle - 1
            elif nums[middle] < target:
                left = middle + 1
            else:
                break
        if nums[middle] != target:
            return[-1,-1]
        i,j = 1, 1
        index_0 = 0
        index_1 = len(nums) - 1
        while middle - i >= 0:
            if nums[middle - i] != target:
                index_0 = middle - i + 1
                break
            i = i + 1
        while middle + j <= len(nums) - 1:
            if nums[middle + j] != target:
                index_1 = middle + j - 1
                break
            j = j + 1
        return [index_0,index_1]
         
