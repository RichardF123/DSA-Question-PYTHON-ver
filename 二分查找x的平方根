class Solution:
    def mySqrt(self, x: int) -> int:
        left = 0
        right = x
        if x == 0:
            return x
        while left <= right:
            middle = int((left + right) / 2)
            if middle**2 == x:
                return middle
            if middle**2 > x:
                right = middle - 1
            if middle**2 < x:
                left = middle + 1
        if middle**2 < x:
            return middle
        if middle**2 > x:
            return middle - 1 
