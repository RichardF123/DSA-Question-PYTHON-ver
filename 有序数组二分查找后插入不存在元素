class Solution:
    def searchInsert(self, nums: List[int], target: int) -> int:
        left = 0
        right = len(nums) - 1
        if target < nums[left]:
            return 0
        if target > nums[right]:
            return right + 1
        while left < right:
            middle = (left + right) // 2
            if nums[middle] == target:
                return middle
            if nums[middle] > target:
                right = middle
            if nums[middle] < target:
                left = middle + 1
        return left
