class Solution:
    def canConstruct(self, ransomNote: str, magazine: str) -> bool:
        record = dict()
        for i in magazine:
            record[i] = record.get(i,0) + 1
        for j in ransomNote:
            if j not in record or record[j] == 0:
                return False
            record[j] -= 1
        return True
